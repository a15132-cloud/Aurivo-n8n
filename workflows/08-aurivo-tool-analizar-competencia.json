{
  "name": "Aurivo - Tool: Analizar Competencia",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"giro\": \"\",\n  \"zona\": \"\"\n}"
      },
      "id": "trigger-exec-wf",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "google_places_api_key",
              "value": "REEMPLAZA_CON_TU_GOOGLE_PLACES_API_KEY",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "set-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1000, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://maps.googleapis.com/maps/api/place/textsearch/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.giro + ' en ' + $json.zona }}" },
            { "name": "key", "value": "={{ $json.google_places_api_key }}" }
          ]
        },
        "options": {}
      },
      "id": "http-places-search",
      "name": "Buscar Competidores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst results = ($json.results || []).slice(0, 8);\n\nreturn results.map(r => ({\n  json: {\n    place_id: r.place_id,\n    nombre: r.name,\n    google_places_api_key: cfg.google_places_api_key\n  }\n}));"
      },
      "id": "code-top8",
      "name": "Tomar Top 8",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://maps.googleapis.com/maps/api/place/details/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "place_id", "value": "={{ $json.place_id }}" },
            {
              "name": "fields",
              "value": "name,rating,user_ratings_total,price_level,website,formatted_phone_number,opening_hours"
            },
            { "name": "key", "value": "={{ $json.google_places_api_key }}" }
          ]
        },
        "options": {}
      },
      "id": "http-places-details",
      "name": "Detalles Competidor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const nivelesPrecio = ['Gratis/No aplica', 'Económico', 'Moderado', 'Caro', 'Muy caro'];\n\nconst competidores = items.map(i => {\n  const d = i.json.result || {};\n  return {\n    nombre: d.name || 'Sin nombre',\n    rating: d.rating || null,\n    resenas: d.user_ratings_total || 0,\n    precio: (d.price_level !== undefined && d.price_level !== null) ? nivelesPrecio[d.price_level] : 'No disponible',\n    sitio_web: d.website || 'Sin sitio web',\n    telefono: d.formatted_phone_number || 'No disponible'\n  };\n});\n\nconst conRating = competidores.filter(c => c.rating);\nconst ratingPromedio = conRating.length ? (conRating.reduce((s, c) => s + c.rating, 0) / conRating.length).toFixed(2) : 'N/D';\nconst conSitio = competidores.filter(c => c.sitio_web !== 'Sin sitio web').length;\n\nlet lineas = competidores.map(c => `- ${c.nombre}: ${c.rating || 'sin rating'}⭐ (${c.resenas} reseñas), precio: ${c.precio}, sitio web: ${c.sitio_web}`);\n\nconst resumen = `Encontré ${competidores.length} competidores.\\nRating promedio de la competencia: ${ratingPromedio}⭐\\n${conSitio} de ${competidores.length} tienen sitio web.\\n\\nDetalle:\\n${lineas.join('\\n')}`;\n\nreturn [{ json: { resumen, competidores } }];"
      },
      "id": "code-formatear",
      "name": "Formatear Comparación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 0]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Buscar Competidores", "type": "main", "index": 0 }]]
    },
    "Buscar Competidores": {
      "main": [[{ "node": "Tomar Top 8", "type": "main", "index": 0 }]]
    },
    "Tomar Top 8": {
      "main": [[{ "node": "Detalles Competidor", "type": "main", "index": 0 }]]
    },
    "Detalles Competidor": {
      "main": [[{ "node": "Formatear Comparación", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
