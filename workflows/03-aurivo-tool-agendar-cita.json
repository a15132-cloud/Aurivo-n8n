{
  "name": "Aurivo - Tool: Agendar Cita",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"titulo\": \"\",\n  \"fecha_hora_inicio\": \"\",\n  \"fecha_hora_fin\": \"\",\n  \"descripcion\": \"\",\n  \"telefono_invitado\": \"\"\n}"
      },
      "id": "trigger-exec-wf",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "calendar_id",
              "value": "REEMPLAZA_CON_TU_CALENDAR_ID",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "timezone",
              "value": "America/Mexico_City",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "set-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "={{ $json.calendar_id }}",
          "mode": "id"
        },
        "start": "={{ $json.fecha_hora_inicio }}",
        "end": "={{ $json.fecha_hora_fin }}",
        "additionalFields": {
          "summary": "={{ $json.titulo }}",
          "description": "={{ $json.descripcion + '\\n\\nContacto WhatsApp: ' + $json.telefono_invitado }}"
        }
      },
      "id": "gcal-create-event",
      "name": "Crear Evento en Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [-320, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Calendar - Aurivo"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "resp-1",
              "name": "status",
              "value": "ok",
              "type": "string"
            },
            {
              "id": "resp-2",
              "name": "evento_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "resp-3",
              "name": "link",
              "value": "={{ $json.htmlLink }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "set-respuesta",
      "name": "Respuesta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-80, 0]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Crear Evento en Calendar", "type": "main", "index": 0 }]]
    },
    "Crear Evento en Calendar": {
      "main": [[{ "node": "Respuesta", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
