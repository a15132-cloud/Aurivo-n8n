          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const spreadsheetId = $('Crear Spreadsheet Nuevo').first().json.spreadsheetId;\nconst rows = $('Filtrar Leads').all().map(i => i.json);\nreturn rows.map(r => ({ json: { ...r, spreadsheetId } }));"
        },
