        "parameters": {
          "mode": "manual",
          "assignments": {
            "assignments": [
              {
                "id": "cfg-1",
                "name": "leads_spreadsheet_id",
                "value": "REEMPLAZA_CON_TU_SPREADSHEET_ID",
                "type": "string"
              },
              {
                "id": "cfg-2",
                "name": "leads_sheet_name",
                "value": "Leads",
                "type": "string"
              }
            ]
          },
          "includeOtherFields": true,
          "options": {}
        },
        "id": "set-config",
        "name": "Config",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          -800,
          0
        ]
      },
      {
        "parameters": {
          "resource": "sheet",
          "operation": "read",
          "documentId": {
            "__rl": true,
            "value": "={{ $json.leads_spreadsheet_id }}",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "={{ $json.leads_sheet_name }}",
            "mode": "id"
          },
          "options": {}
        },
        "id": "sheets-read-leads",
        "name": "Leer Leads",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          -600,
          0
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "REPLACE_ME",
            "name": "Google Sheets - Aurivo"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const cfg = $('Config').first().json;\nconst etapaFiltro = (cfg.etapa_filtro || '').trim();\nconst desde = cfg.fecha_desde ? new Date(cfg.fecha_desde) : null;\nconst hasta = cfg.fecha_hasta ? new Date(cfg.fecha_hasta) : null;\n\nlet rows = items.map(i => i.json);\n\nif (etapaFiltro) {\n  rows = rows.filter(r => (r.etapa || '').toLowerCase() === etapaFiltro.toLowerCase());\n}\nif (desde) {\n  rows = rows.filter(r => new Date(r.fecha_contacto) >= desde);\n}\nif (hasta) {\n  rows = rows.filter(r => new Date(r.fecha_contacto) <= hasta);\n}\n\nreturn rows.map(r => ({ json: r }));"
        },
        "id": "code-filter",
        "name": "Filtrar Leads",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -400,
          0
        ]
      },
