{
  "name": "Aurivo - Tool: Consultar Estadísticas de Leads",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"periodo\": \"semana\"\n}"
      },
      "id": "trigger-exec-wf",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "leads_spreadsheet_id",
              "value": "REEMPLAZA_CON_TU_SPREADSHEET_ID",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "leads_sheet_name",
              "value": "Leads",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "set-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.leads_spreadsheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.leads_sheet_name }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "sheets-read-leads",
      "name": "Leer Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-320, -80],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets - Aurivo"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const periodo = $('Config').first().json.periodo || 'todo';\nconst rows = items.map(i => i.json);\nconst now = new Date();\n\nfunction diasDesde(fechaStr) {\n  const f = new Date(fechaStr);\n  if (isNaN(f.getTime())) return Infinity;\n  return (now - f) / (1000 * 60 * 60 * 24);\n}\n\nlet limiteDias = Infinity;\nif (periodo === 'semana') limiteDias = 7;\nif (periodo === 'mes') limiteDias = 30;\n\nconst filtradas = rows.filter(r => diasDesde(r.fecha_contacto) <= limiteDias);\n\nconst porEtapa = {};\nfor (const r of filtradas) {\n  const etapa = r.etapa || 'sin_etapa';\n  porEtapa[etapa] = (porEtapa[etapa] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    periodo,\n    total_leads_en_periodo: filtradas.length,\n    total_leads_historico: rows.length,\n    leads_por_etapa: porEtapa,\n    clientes_conseguidos_en_periodo: (porEtapa['Cliente'] || porEtapa['cliente'] || 0)\n  }\n}];"
      },
      "id": "code-stats",
      "name": "Calcular Estadísticas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, -80]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Leer Leads", "type": "main", "index": 0 }]]
    },
    "Leer Leads": {
      "main": [[{ "node": "Calcular Estadísticas", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
