            "fecha_hora_inicio": "={{ $fromAI('fecha_hora_inicio', 'Fecha y hora de inicio en formato ISO 8601, ej. 2026-08-10T15:00:00-06:00', 'string') }}",
            "fecha_hora_fin": "={{ $fromAI('fecha_hora_fin', 'Fecha y hora de fin en formato ISO 8601', 'string') }}",
            "descripcion": "={{ $fromAI('descripcion', 'Descripción breve del motivo de la cita', 'string') }}",
            "telefono_invitado": "={{ $json.from }}"
          }
        }
