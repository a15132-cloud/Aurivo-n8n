      "parameters": {
        "name": "Registrar_Lead",
        "description": "Registra o actualiza un lead en la hoja de cálculo maestra. Úsala cada vez que obtengas o confirmes datos del contacto: nombre del negocio/persona, email, ubicación, y su etapa actual ('contactado', 'interesado' o 'Cliente').",
        "workflowId": {
          "__rl": true,
          "value": "REEMPLAZA_CON_ID_DEL_WORKFLOW_02",
          "mode": "list",
          "cachedResultName": "Aurivo - Tool: Registrar Lead"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "nombre_negocio": "={{ $fromAI('nombre_negocio', 'Nombre del negocio o persona de contacto', 'string') }}",
            "email": "={{ $fromAI('email', 'Email de contacto si se conoce, si no dejar vacío', 'string') }}",
            "telefono": "={{ $json.from }}",
            "ubicacion": "={{ $fromAI('ubicacion', 'Ciudad, colonia o dirección del negocio si se conoce', 'string') }}",
            "etapa": "={{ $fromAI('etapa', \"Etapa del lead: 'contactado', 'interesado' o 'Cliente'\", 'string') }}",
            "notas": "={{ $fromAI('notas', 'Notas relevantes de la conversación', 'string') }}"
          }
        }
      },
