      "name": "Tool: Registrar Lead",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.1,
      "position": [-660, 120]
    },
    {
      "parameters": {
        "name": "Agendar_Cita",
        "description": "Agenda una cita en el calendario del negocio cuando el cliente confirma día y hora. Requiere título, fecha/hora de inicio y fin en formato ISO 8601, y una descripción breve.",
        "workflowId": {
          "__rl": true,
          "value": "REEMPLAZA_CON_ID_DEL_WORKFLOW_03",
          "mode": "list",
          "cachedResultName": "Aurivo - Tool: Agendar Cita"
