            "etapa": "={{ $json.etapa }}", "fecha_contacto": "={{ $json.fecha_contacto }}",
            "notas": "={{ $json.notas }}"
          }
        }, "options": {}
      },
      "id": "sheets-write-report", "name": "Escribir Datos del Reporte",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-560, -440],
