      "id": "sheets-leer-leads-stats", "name": "Leer Leads (Stats)",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-1360, -720],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets - Aurivo" } }
    },
    { "parameters": {
        "mode": "runOnceForAllItems", "language": "javaScript",
        "jsCode": "const periodo = $('Config').first().json.periodo || 'todo';\nconst rows = items.map(i => i.json);\nconst now = new Date();\n\nfunction diasDesde(fechaStr) {\n  const f = new Date(fechaStr);\n  if (isNaN(f.getTime())) return Infinity;\n  return (now - f) / (1000 * 60 * 60 * 24);\n}\n\nlet limiteDias = Infinity;\nif (periodo === 'semana') limiteDias = 7;\nif (periodo === 'mes') limiteDias = 30;\n\nconst filtradas = rows.filter(r => diasDesde(r.fecha_contacto) <= limiteDias);\n\nconst porEtapa = {};\nfor (const r of filtradas) {\n  const etapa = r.etapa || 'sin_etapa';\n  porEtapa[etapa] = (porEtapa[etapa] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    periodo,\n    total_leads_en_periodo: filtradas.length,\n    total_leads_historico: rows.length,\n    leads_por_etapa: porEtapa,\n    clientes_conseguidos_en_periodo: (porEtapa['Cliente'] || porEtapa['cliente'] || 0)\n  }\n}];"
      },
      "id": "code-stats", "name": "Calcular Estadísticas",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-1160, -720]
    },

    { "parameters": {
        "resource": "sheet", "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $json.leads_spreadsheet_id }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "={{ $json.leads_sheet_name }}", "mode": "id" },
        "options": {}
      },
      "id": "sheets-leer-leads-reporte", "name": "Leer Leads (Reporte)",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-1360, -440],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets - Aurivo" } }
    },
    { "parameters": {
        "mode": "runOnceForAllItems", "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst etapaFiltro = (cfg.etapa_filtro || '').trim();\nconst desde = cfg.fecha_desde ? new Date(cfg.fecha_desde) : null;\nconst hasta = cfg.fecha_hasta ? new Date(cfg.fecha_hasta) : null;\n\nlet rows = items.map(i => i.json);\n\nif (etapaFiltro) {\n  rows = rows.filter(r => (r.etapa || '').toLowerCase() === etapaFiltro.toLowerCase());\n}\nif (desde) {\n  rows = rows.filter(r => new Date(r.fecha_contacto) >= desde);\n}\nif (hasta) {\n  rows = rows.filter(r => new Date(r.fecha_contacto) <= hasta);\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "code-filter", "name": "Filtrar Leads",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-1160, -440]
    },
    { "parameters": {
        "resource": "spreadsheet", "operation": "create",
        "title": "=Leads Aurivo - {{ $now.format('yyyy-MM-dd HH-mm') }}",
        "sheetsUi": {}
      },
      "id": "sheets-create-spreadsheet", "name": "Crear Spreadsheet Nuevo",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-960, -440], "executeOnce": true,
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets - Aurivo" } }
    },
    { "parameters": {
        "mode": "runOnceForAllItems", "language": "javaScript",
        "jsCode": "const spreadsheetId = $('Crear Spreadsheet Nuevo').first().json.spreadsheetId;\nconst rows = $('Filtrar Leads').all().map(i => i.json);\nreturn rows.map(r => ({ json: { ...r, spreadsheetId } }));"
      },
      "id": "code-prepare-rows", "name": "Preparar Filas Para Escribir",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-760, -440]
    },
    { "parameters": {
        "resource": "sheet", "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $json.spreadsheetId }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "gid=0", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow", "matchingColumns": ["telefono"],
          "value": {
            "nombre_negocio": "={{ $json.nombre_negocio }}", "email": "={{ $json.email }}",
